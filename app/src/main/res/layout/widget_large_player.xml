<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/w_art"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:scaleType="centerCrop"
            android:background="@drawable/widget_art_bg"
            android:src="@drawable/ic_widget_music"
            android:contentDescription="Album Art" />

        <LinearLayout
            android:id="@+id/w_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/w_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CADENCE"
                android:textColor="#8B5CF6"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="2dp"
                android:text="Cadence" />

            <TextView
                android:id="@+id/w_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#A39FB5"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="2dp"
                android:text="Ready to play" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="8dp">

        <ImageButton
            android:id="@+id/w_prev"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_widget_prev"
            android:background="?android:selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:contentDescription="Previous" />

        <Space
            android:layout_width="24dp"
            android:layout_height="wrap_content" />

        <ImageButton
            android:id="@+id/w_toggle"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_widget_play"
            android:background="@drawable/widget_play_btn_bg"
            android:padding="12dp"
            android:contentDescription="Play or Pause" />

        <Space
            android:layout_width="24dp"
            android:layout_height="wrap_content" />

        <ImageButton
            android:id="@+id/w_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_widget_next"
            android:background="?android:selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:contentDescription="Next" />
    </LinearLayout>
</LinearLayout>
