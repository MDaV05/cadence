<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="@drawable/widget_bg">

    <ImageView
        android:id="@+id/w_art"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:scaleType="centerCrop"
        android:background="@drawable/widget_art_bg"
        android:src="@drawable/ic_widget_music"
        android:contentDescription="Album Art" />

    <LinearLayout
        android:id="@+id/w_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/w_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Cadence" />

        <TextView
            android:id="@+id/w_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#A39FB5"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Ready to play" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/w_prev"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_widget_prev"
            android:background="?android:selectableItemBackgroundBorderless"
            android:padding="7dp"
            android:contentDescription="Previous" />

        <ImageButton
            android:id="@+id/w_toggle"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_widget_play"
            android:background="@drawable/widget_play_btn_bg"
            android:padding="9dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="Play or Pause" />

        <ImageButton
            android:id="@+id/w_next"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_widget_next"
            android:background="?android:selectableItemBackgroundBorderless"
            android:padding="7dp"
            android:contentDescription="Next" />
    </LinearLayout>
</LinearLayout>
